// ManyChat Alternative — B2B Instagram Comment → DM SaaS schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  ownedWorkspaces  Workspace[]           @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  sentInvitations  WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usagePeriodStart  DateTime @default(now())
  dmsSentThisPeriod Int      @default(0)

  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  instagramAccounts InstagramAccount[]
  automations       Automation[]
  dmLogs            DmLog[]
  trackedLinks      TrackedLink[]
  linkClicks        LinkClick[]
  webhookEvents     WebhookEvent[]
  operationalEvents OperationalEvent[]
  contacts          Contact[]
  calendars         Calendar[]
  bookings          Booking[]
  forms             Form[]
  folders           Folder[]
  formSubmissions   FormSubmission[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

model InstagramAccount {
  id                String    @id @default(cuid())
  workspaceId       String
  instagramId       String    @unique
  username          String
  name              String?
  accessToken       String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean   @default(false)
  connectedAt       DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations       Automation[]
  dmLogs            DmLog[]
  linkClicks        LinkClick[]
  followerSnapshots FollowerSnapshot[]

  @@index([workspaceId])
}

/// Daily follower total for one account. Instagram only retains ~30 days of
/// account insights, so history beyond that window exists only because we
/// record it here. One row per account per day.
model FollowerSnapshot {
  id                 String   @id @default(cuid())
  instagramAccountId String
  /// Midnight UTC of the day this count belongs to.
  date               DateTime @db.Date
  followersCount     Int
  /// True when the row was reconstructed from follower_count insight deltas
  /// rather than observed directly, so it can be corrected later.
  backfilled         Boolean  @default(false)
  createdAt          DateTime @default(now())

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, date])
  @@index([instagramAccountId, date])
}

model Automation {
  id                 String @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  name                     String
  goal                     String?
  postId                   String?
  postUrl                  String?
  pendingNextReel          Boolean  @default(false)
  matchAnyPost             Boolean  @default(false)
  keywords                 String[]
  matchAnyWord             Boolean  @default(false)
  // Also fire this campaign when someone sends a DM whose text matches the
  // keywords above. Independent of the post trigger — a DM has no media, so
  // postId / matchAnyPost do not apply to it.
  dmTriggerEnabled         Boolean  @default(false)
  // Fire this campaign when someone replies to one of the account's stories.
  // Stories have no comments, so Instagram delivers a story reply as an
  // ordinary message carrying `reply_to.story`. Separate from dmTriggerEnabled
  // so a campaign can target story replies WITHOUT also answering every DM.
  storyReplyTriggerEnabled Boolean  @default(false)
  // Which story the reply must be on. Null means any story. Instagram
  // stories expire after 24h, so a campaign pinned to one simply stops
  // matching once it is gone — deliberately not auto-widened to "any".
  storyId                  String?
  dmMessage                String
  openingDmEnabled         Boolean  @default(false)
  openingDmMessage         String?
  openingDmButtonLabel     String?
  linkButtonLabel          String?
  requireFollow            Boolean  @default(false)
  followPromptMessage      String?
  followPromptButtonLabel  String?
  followUpEnabled          Boolean  @default(false)
  followUpMessage          String?
  // Minutes to wait after the link is delivered before sending the follow-up.
  // 0 sends it right away.
  followUpDelayMinutes     Int      @default(0)
  publicReplyEnabled       Boolean  @default(false)
  publicReplyMessage       String?
  publicReplyMessages      String[] @default([])
  isActive                 Boolean  @default(true)
  wholeWordMatch           Boolean  @default(true)
  reportShareSlug          String?  @unique
  reportShareEnabled       Boolean  @default(true)
  // Optional organisational folder (one flat level, e.g. "September").
  folderId                 String?
  // Set when archived. Archiving also pauses (isActive=false), so every
  // matcher that filters on isActive already ignores archived automations.
  archivedAt               DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  folder           Folder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  dmLogs           DmLog[]
  trackedLinks     TrackedLink[]
  linkClicks       LinkClick[]

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([postId])
  @@index([folderId])
}

// A flat folder for grouping campaigns / story automations (both are
// Automation rows). Deleting a folder unfiles its automations (SetNull).
model Folder {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations Automation[]

  @@index([workspaceId])
}

model DmLog {
  id                 String @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String

  commenterId    String
  commenterName  String?
  commentText    String
  commentId      String
  matchedKeyword String?
  status         DmStatus  @default(PENDING)
  attempts       Int       @default(0)
  dmSentAt       DateTime?
  errorMessage   String?

  // The public comment reply is delivered independently of the DM, so its
  // outcome is tracked separately. publicReplySentAt makes it idempotent across
  // retries; a DM failure never blocks or re-posts the public reply.
  publicReplySentAt DateTime?
  publicReplyError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([automationId, commentId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([status])
}

// Every comment the system has seen, from either the webhook or the polling
// reconciler. This is the shared dedup set: a comment id present here has
// already been queued for processing, so neither path acts on it twice. It is
// distinct from DmLog (which only records comments that matched a campaign);
// this records all comments so the reconciler doesn't re-sweep non-matching
// ones every cycle.
model ProcessedComment {
  id                 String   @id @default(cuid())
  instagramAccountId String
  commentId          String   @unique
  source             String // "WEBHOOK" | "POLLING"
  seenAt             DateTime @default(now())

  @@index([instagramAccountId])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
  @@index([automationId])
}

model LinkClick {
  id                 String   @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String
  trackedLinkId      String
  ipHash             String?
  userAgent          String?
  referrer           String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  trackedLink      TrackedLink      @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([trackedLinkId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

model WebhookEvent {
  id           String        @id @default(cuid())
  workspaceId  String?
  object       String?
  payload      Json
  status       WebhookStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime      @default(now())
  processedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
}

model OperationalEvent {
  id          String                 @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel  @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime               @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DmStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR
}

// ---------------------------------------------------------------------------
// CRM: contacts, booking calendars, and public forms.
//
// This is the GoHighLevel half of the product: a public form captures a lead,
// the lead books a slot on a public calendar page, and both land on a single
// Contact row that the owner reviews inside the dashboard.
// ---------------------------------------------------------------------------

model Contact {
  id          String  @id @default(cuid())
  workspaceId String
  name        String?
  email       String?
  phone       String?
  // ISO-3166 alpha-2, read from the CDN's geo header on public submissions.
  country     String?
  // Set when a contact is later reconciled with an Instagram commenter.
  instagramId String?
  // MANUAL | FORM | BOOKING | INSTAGRAM
  source      String  @default("MANUAL")
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  submissions FormSubmission[]

  // Postgres treats NULLs as distinct, so any number of contacts may have no
  // email without colliding. This is what makes "upsert by email" safe.
  @@unique([workspaceId, email])
  @@index([workspaceId, createdAt])
}

model Calendar {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  slug        String  @unique
  description String?

  // IANA zone the availability windows below are expressed in, e.g. Asia/Amman.
  timezone        String @default("UTC")
  durationMinutes Int    @default(30)
  bufferMinutes   Int    @default(0)
  minNoticeHours  Int    @default(12)
  maxDaysAhead    Int    @default(30)

  // ponytail: weekly hours as JSON keyed by weekday 0-6 (0 = Sunday), in
  // `timezone`: { "1": [["09:00","17:00"]], "2": [["09:00","12:00"],["13:00","17:00"]] }
  // No per-date overrides and no holiday table — add an AvailabilityOverride
  // model if blocking a single day is ever needed.
  availability Json @default("{}")

  // The form shown as one of the two booking steps. Null means the booking
  // page only asks for name, email and phone.
  formId String?

  // ponytail: a boolean, not an ordered list — there are exactly two widgets,
  // so there are exactly two orders. This becomes a real array only if a third
  // step is ever added.
  formFirst Boolean @default(true)

  // The confirmation page shown after a successful booking.
  successMessage String  @default("Thanks! We'll review your request and get back to you.")
  redirectUrl    String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  form      Form?     @relation(fields: [formId], references: [id], onDelete: SetNull)
  bookings  Booking[]

  @@index([workspaceId])
  @@index([formId])
}

model Booking {
  id          String @id @default(cuid())
  workspaceId String
  calendarId  String
  contactId   String

  // Always UTC. `timezone` is the visitor's own zone, kept so the dashboard can
  // show the time they actually saw when they booked.
  startsAt DateTime
  endsAt   DateTime
  timezone String

  status      BookingStatus @default(PENDING)
  notes       String?
  // Answers carried over from the form that led to this booking, if any.
  answers     Json?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  calendar  Calendar  @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // ponytail: no unique index on [calendarId, startsAt] — a cancelled booking
  // must free its slot again. Conflicts are checked inside the booking
  // transaction instead. Add a partial unique index (WHERE status <> 'CANCELLED')
  // if a real double-booking ever lands.
  @@index([calendarId, startsAt])
  @@index([workspaceId, status])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Form {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  slug        String @unique

  headline          String?
  description       String?
  submitButtonLabel String  @default("Submit")
  successMessage    String  @default("Thanks! We'll be in touch.")
  redirectUrl       String?

  // [{ id, type, label, placeholder?, required, options?[] }] — see
  // lib/forms/fields.ts for the authoritative shape and its zod schema.
  fields Json @default("[]")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // A form can serve several calendars; the calendar owns the link.
  calendars   Calendar[]
  submissions FormSubmission[]

  @@index([workspaceId])
}

model FormSubmission {
  id          String  @id @default(cuid())
  workspaceId String
  formId      String
  contactId   String?

  // { fieldId: value } — values are strings, or string[] for checkbox fields.
  answers Json
  country String?

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  form      Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([formId, createdAt])
  @@index([workspaceId])
}
